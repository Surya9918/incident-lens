# Production requires a unique >=32-character token and exact public origin.
# Generate a token: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NODE_ENV=production
API_TOKEN=
APP_ORIGIN=https://incidents.example.com
HOST=0.0.0.0
PORT=3000
DB_PATH=/app/data/incidents.db
DEMO_ENABLED=false
RETENTION_DAYS=7
MAX_INCIDENTS=500
